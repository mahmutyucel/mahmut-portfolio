generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id        Int    @id @default(autoincrement())
  bio       String
}

model Experience {
  id      Int    @id @default(autoincrement())
  title   String
  company String
  type    String
  logo    String
}

model Project {
  id          Int    @id @default(autoincrement())
  number      String
  category    String
  title       String
  description String
  tags        String 
}

model Skill {
  id       Int    @id @default(autoincrement())
  category String
  items    String 
}

model Issuer {
  id           Int           @id @default(autoincrement())
  name         String
  logo         String
  certificates Certificate[]
}

model Certificate {
  id       Int    @id @default(autoincrement())
  name     String
  issuerId Int
  issuer   Issuer @relation(fields: [issuerId], references: [id], onDelete: Cascade)
}